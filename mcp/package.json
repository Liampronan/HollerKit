{
  "name": "hollerkit-mcp",
  "version": "1.0.0-beta.1",
  "description": "MCP server and client for HollerKit v1 feedback triage and QA quest management.",
  "type": "module",
  "bin": {
    "hollerkit-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:server": "tsc -p ../server/tsconfig.build.json --typeRoots ./node_modules/@types",
    "prepack": "npm run build",
    "test": "npm run build:server && npm run build && node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "hollerkit",
    "mcp",
    "model-context-protocol",
    "qa",
    "bug-reporting"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
