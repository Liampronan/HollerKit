{
  "name": "hollerkit-server",
  "version": "1.0.0-beta.2",
  "description": "Self-hosted /v1 server handler, storage adapters, and CLI for HollerKit bug reports and QA quests.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "hollerkit": "dist/cli.js",
    "hollerkit-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bug-reporting",
    "github-issues",
    "hollerkit"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
