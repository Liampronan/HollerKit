{
  "name": "hollerkit-server",
  "version": "1.0.0-beta.3",
  "description": "Self-hosted /v1 server handler, storage adapters, and CLI for HollerKit bug reports and QA quests.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "hollerkit": "dist/cli.js",
    "hollerkit-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liampronan/HollerKit.git",
    "directory": "server"
  },
  "homepage": "https://github.com/Liampronan/HollerKit#readme",
  "bugs": {
    "url": "https://github.com/Liampronan/HollerKit/issues"
  },
  "author": "Liam Ronan",
  "keywords": [
    "bug-reporting",
    "qa-quests",
    "hollerkit"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "postgres": "^4.1.0"
  }
}
